# MongoDB Connection (add your own URI)
# For local development: mongodb://localhost:27017/affordablewigs
# For Railway: Use the URI provided in your Railway dashboard
MONGODB_URI=mongodb://mongo:aQhnMdMeBXQNirEDcwomJONJgmoDQwHa@monorail.proxy.rlwy.net:11396

# Paystack Configuration
# Get these from your Paystack dashboard: https://dashboard.paystack.co/#/settings/developer
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Site URL (required for payment callbacks)
# CRITICAL: In Railway, set this EXACTLY to your production URL.
# If this is left as localhost, Paystack will redirect customers to
# http://localhost:3000 which does not exist in production — users
# will be permanently stuck on the Paystack page after paying.
#
# Local development:  http://localhost:3000
# Production:         https://affordablewigs-production.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
